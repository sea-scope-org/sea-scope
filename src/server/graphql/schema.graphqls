scalar DateTime
scalar Date
# Untyped JSON payload — used only where the GraphQL schema is itself a union
# of values that the UI surfaces verbatim (e.g. tool call arguments rendered
# in a debug/inspect dialog). See docs/architecture/chat.md.
scalar JSON

type ChatMessageUser {
    chatMessageId: ID!
    author: User!
    body: String!
    # Files the user attached to this message, in send-order. Empty list when
    # the message was a plain-text send. The bytes are not exposed inline —
    # `FileUpload.url` points at `/api/file-uploads/:id` which streams them
    # back behind the same session cookie that authorized the upload.
    attachments: [FileUpload!]!
    createdAt: DateTime!
}

# A persisted user-uploaded file. Consumer-agnostic — chat surfaces these
# today as message attachments via the `ChatMessageUser.attachments` field,
# but the same shape is reused by other surfaces (e.g. assistant-side
# outputs, avatars, document uploads).
type FileUpload {
    fileUploadId: ID!
    filename: String!
    # IANA media type — drives both the in-bubble preview (image vs file
    # chip) and the LLM-side `FilePart` `mediaType` in
    # `toModelMessages`.
    mediaType: String!
    # Size in bytes. Mirrors what the upload route persisted; clamped at the
    # route, not validated again here.
    size: Int!
    # Server-rooted URL to stream the bytes back. Today: `/api/file-uploads/:id`.
    url: String!
}

# Snapshot of a single LLM step's identity and token usage. Attached to every
# AI-produced message variant — see `docs/architecture/chat-persistence.md`
# ("Generation metadata"). The whole field is nullable on the parent variants
# because pre-feature rows have no usage and rare provider responses may omit
# the model id; when present, `modelId` is always populated. The token fields
# are individually nullable because providers vary (Gemini reports
# `cachedInputTokens`; OpenAI reports `reasoningTokens`; some omit
# `totalTokens` and the server falls back to `inputTokens + outputTokens`).
#
# A single LLM step can produce multiple message rows (text + N tool calls);
# each row carries the same snapshot, so naive `SUM(totalTokens)` aggregations
# over-count. Group by `(chatMessageId, step boundary)` for accurate totals.
type ChatMessageGeneration {
    modelId: String!
    inputTokens: Int
    outputTokens: Int
    totalTokens: Int
    reasoningTokens: Int
    cachedInputTokens: Int
}

type ChatMessageAssistantText {
    chatMessageId: ID!
    # Flattened markdown from `blocks` (copy / titles / LLM replay). Prefer
    # `blocks` for rendering mixed markdown + card lists.
    body: String!
    # Ordered reply segments (markdown, card lists). Persisted as jsonb on
    # the row. See `docs/architecture/chat.md` ("Assistant presentation").
    blocks: [ChatAssistantBodyBlock!]!
    # Gemini thought summary for the LLM step that produced this answer
    # (`thinkingConfig.includeThoughts`). Null when the model emitted none
    # (Flash disables thinking) or for legacy rows. Live deltas stream via
    # `ChatUpdateAssistantReasoningChunk` keyed on this row's id; this field
    # is the durable copy. Multi-step turns keep each step's thoughts on the
    # tool / approval / collection row that step produced — only the final
    # step's summary lands here.
    reasoning: String
    # Provider grounding sources for this answer (deduped across the turn).
    # Empty when the model attached none. See `ChatMessageSource`.
    sources: [ChatMessageSource!]!
    # Snapshot of the LLM step that produced this row. See `ChatMessageGeneration`.
    generation: ChatMessageGeneration
    createdAt: DateTime!
}

type ChatMessageSource {
    title: String!
    url: String!
}

type ChatMessageToolCall {
    chatMessageId: ID!
    toolName: String!
    # Per-tool-typed call arguments, exposed as opaque JSON so the UI can
    # render them in an inspect dialog. The shape is only validated at the
    # tool boundary by Zod.
    args: JSON!
    # When a sub-agent runs inside a parent tool's `execute`, each child tool
    # call is persisted with `parentChatMessageId` set to the parent delegate
    # row's id. The transcript filters child rows out of the top-level list
    # and renders them indented under the parent's card. Null for top-level
    # tool calls. See `docs/architecture/agent-delegation.md`
    # ("Nested tool calls").
    parentChatMessageId: ID
    # The tool's return value, opaque JSON (same rationale as `args`). Null
    # while a call is still in flight or for tools that return void. The UI
    # reads a `{ status, summary }` convention when present to drive the row's
    # status indicator + inline summary, and otherwise shows the raw JSON in
    # the inspector. See docs/styles/chat.md.
    toolResult: JSON
    # Thought summary for the LLM step that decided on this call. Set only on
    # the first persisted artifact of a parallel multi-tool step; null on
    # siblings and when the model emitted no thoughts.
    reasoning: String
    generation: ChatMessageGeneration
    createdAt: DateTime!
}

type ChatMessageToolApprovalRequest {
    chatMessageId: ID!
    approvalId: String!
    toolName: String!
    # The pending call's arguments — same shape and rationale as
    # `ChatMessageToolCall.args`. Surfaced so the human can inspect what the
    # assistant is asking permission to run before approving.
    args: JSON!
    # Thought summary for the step that requested approval — same first-of-step
    # rule as `ChatMessageToolCall.reasoning`.
    reasoning: String
    generation: ChatMessageGeneration
    createdAt: DateTime!
}

type ChatMessageToolApprovalResponse {
    chatMessageId: ID!
    approvalId: String!
    approved: Boolean!
    # Optional free-text justification the human typed when responding. The
    # SDK's `ToolApprovalResponse` carries this through to the synthetic
    # denied tool-result so the LLM sees *why* a call was declined.
    reason: String
    createdAt: DateTime!
}

# --- Assistant input collection ----------------------------------------------
#
# A single assistant turn that asks the user for one or more structured values.
# Each entry in `inputs` is a typed slot — see `union ChatAssistantInput`.
# The user's response is a single `ChatMessageUserInput` carrying one
# `ChatMessageUserInputAnswer` per answered slot (all-or-nothing submit).

type ChatMessageAssistantInputCollection {
    chatMessageId: ID!
    prompt: String!
    inputs: [ChatAssistantInput!]!
    # `Form` renders every slot at once; `StepThrough` walks the user through
    # one slot at a time. The submitted answer set is identical between modes —
    # the wizard accumulates drafts client-side and submits the same batch the
    # form does. Picked by the LLM via the `promptUserForInput` tool's `mode`
    # input; defaults to `Form`.
    #
    # Plain `String!` (not a GraphQL enum) so the typescript-operations
    # codegen plugin doesn't re-emit a duplicate type alias next to the one
    # the typescript plugin already emits. Same workaround the inlined
    # mutations use for named input types — see chat.md.
    mode: String!
    # Thought summary for the step that produced this collection — same
    # first-of-step rule as `ChatMessageToolCall.reasoning`.
    reasoning: String
    generation: ChatMessageGeneration
    createdAt: DateTime!
}

union ChatAssistantInput =
    | ChatAssistantInputDate
    | ChatAssistantInputDateRange
    | ChatAssistantInputDateTime
    | ChatAssistantInputTime
    | ChatAssistantInputSingleSelect
    | ChatAssistantInputMultiSelect
    | ChatAssistantInputBoolean
    | ChatAssistantInputText

type ChatAssistantInputDate {
    inputId: ID!
    prompt: String!
}

type ChatAssistantInputDateRange {
    inputId: ID!
    prompt: String!
}

type ChatAssistantInputDateTime {
    inputId: ID!
    prompt: String!
}

type ChatAssistantInputTime {
    inputId: ID!
    prompt: String!
}

type ChatAssistantInputSingleSelect {
    inputId: ID!
    prompt: String!
    options: [String!]!
}

type ChatAssistantInputMultiSelect {
    inputId: ID!
    prompt: String!
    options: [String!]!
}

type ChatAssistantInputBoolean {
    inputId: ID!
    prompt: String!
}

type ChatAssistantInputText {
    inputId: ID!
    prompt: String!
}

# --- User response to an assistant input collection --------------------------

type ChatMessageUserInput {
    chatMessageId: ID!
    author: User!
    collectionMessageId: ID!
    # Real submits carry one entry per answered slot; an empty list signals
    # the row is protocol-only — written by `chatMessageCreate` to close an
    # open collection when the user sent a free-text message instead of
    # filling the form. See "Pivoting away from an open collection" in
    # docs/architecture/chat.md.
    answers: [ChatMessageUserInputAnswer!]!
    createdAt: DateTime!
}

type ChatMessageUserInputAnswer {
    inputId: ID!
    value: ChatAssistantInputValue!
}

union ChatAssistantInputValue =
    | ChatAssistantInputValueDate
    | ChatAssistantInputValueDateRange
    | ChatAssistantInputValueDateTime
    | ChatAssistantInputValueTime
    | ChatAssistantInputValueString
    | ChatAssistantInputValueStringList
    | ChatAssistantInputValueBoolean

type ChatAssistantInputValueDate {
    date: Date!
}

type ChatAssistantInputValueDateRange {
    from: Date!
    to: Date!
}

type ChatAssistantInputValueDateTime {
    dateTime: DateTime!
}

type ChatAssistantInputValueTime {
    # ISO 8601 local time, e.g. "14:30"
    time: String!
}

type ChatAssistantInputValueString {
    value: String!
}

type ChatAssistantInputValueStringList {
    values: [String!]!
}

type ChatAssistantInputValueBoolean {
    boolean: Boolean!
}

# --- Assistant body blocks ---------------------------------------------------
#
# Ordered segments of an assistant reply. Persisted as jsonb on
# `ChatMessageAssistantText.body`, streamed live via presentation `ChatUpdate`s.
# See `docs/architecture/chat.md` ("Assistant presentation").

union ChatAssistantBodyBlock = ChatAssistantBodyBlockMarkdown | ChatAssistantBodyBlockCardList

type ChatAssistantBodyBlockMarkdown {
    text: String!
}

type ChatAssistantBodyBlockCardList {
    cards: [ChatAssistantArtifactCard!]!
}

type ChatAssistantArtifactCard {
    imageUrl: String
    title: String!
    description: String!
    price: String
    href: String
    buttonTitle: String
}

# --- Top-level chat message union --------------------------------------------

union ChatMessage =
    | ChatMessageUser
    | ChatMessageUserInput
    | ChatMessageAssistantText
    | ChatMessageToolCall
    | ChatMessageToolApprovalRequest
    | ChatMessageToolApprovalResponse
    | ChatMessageAssistantInputCollection

type Chat {
    chatId: ID!
    title: String!
    lastModifiedAt: DateTime!
    # Flat insertion-ordered list. Day-grouping is a render-time concern in the
    # client (the live `chatUpdates` subscription delivers raw messages, so the
    # client has to be the grouping authority anyway).
    messages: [ChatMessage!]!
}

input UserCreate {
    name: String!
}

input UserUpdate {
    name: String!
}

type User {
    userId: ID!
    name: String!
    # Admin read namespace — non-null only for the session's own admin user
    # (`Users.isAdmin = true`). Null for anonymous sessions, non-admin logged-in
    # users, and any future cross-user lookups. Lets public surfaces ask "is the
    # current user an admin?" with a single nullable field check instead of
    # catching a `guardAdmin` exception. Mutations still live on
    # `Mutation.admin`. See `docs/architecture/authorization-admin.md`.
    admin: Admin
}

type Session {
    sessionId: ID!
    user: User
    chat(chatId: ID!): Chat!
    # Live watch board for this cookie session (in-memory scenario player).
    # Always present — resolving `watch` ensures the default scenario is running.
    watch: WatchState!
    scenarios: [ScenarioSummary!]!
}

type MutationResult {
    success: Boolean!
    referenceId: ID
}

type ChatMessageCreateResult {
    chatId: ID!
    chatMessageId: ID!
}

# --- SeaScope watch board ----------------------------------------------------

enum AnomalyKind {
    speedDrop
    headingZigZag
    loitering
    aisDark
    impossibleJump
}

enum AnomalySeverity {
    low
    medium
    high
    critical
}

enum WatchStatus {
    running
    completed
}

enum RiskLevel {
    green
    yellow
    orange
    red
}

enum RiskTrend {
    rising
    stable
    falling
}

enum RiskRule {
    baseline
    speedDrop
    headingZigZag
    loitering
    aisDark
    impossibleJump
    zoneEntry
    nearProtectedAsset
    aisRadarMismatch
}

enum ProtectedAssetType {
    cable
    pipeline
    harbor
    windFarm
    restrictedZone
}

enum IncidentStatus {
    open
    acknowledged
    closed
}

type LatLon {
    lat: Float!
    lon: Float!
}

type VesselPosition {
    mmsi: ID!
    lat: Float!
    lon: Float!
    sog: Float!
    cog: Float!
    heading: Float!
    timestamp: DateTime!
    navStatus: String
}

type RiskFactor {
    rule: RiskRule!
    scoreDelta: Int!
    explanation: String!
    source: String!
}

type Vessel {
    mmsi: ID!
    name: String!
    imo: String
    callSign: String
    shipType: String!
    flag: String!
    aisDark: Boolean!
    position: VesselPosition
    riskScore: Int!
    riskLevel: RiskLevel!
    riskTrend: RiskTrend!
    activeFactors: [RiskFactor!]!
    nearestAssetId: ID
    nearestAssetDistanceNm: Float
    trackTail: [LatLon!]!
    radarPosition: LatLon
}

type Anomaly {
    anomalyId: ID!
    mmsi: ID!
    kind: AnomalyKind!
    severity: AnomalySeverity!
    title: String!
    summary: String!
    detectedAtSimMs: Float!
    evidence: JSON!
}

type RiskEvent {
    riskEventId: ID!
    mmsi: ID!
    detectedAtSimMs: Float!
    rule: RiskRule!
    scoreDelta: Int!
    previousScore: Int!
    newScore: Int!
    explanation: String!
    source: String!
}

type ProtectedAsset {
    assetId: ID!
    name: String!
    type: ProtectedAssetType!
    path: [LatLon!]!
    riskRadiusNm: Float!
}

type IncidentTimelineEvent {
    eventId: ID!
    detectedAtSimMs: Float!
    eventType: String!
    source: String!
    explanation: String!
    riskChange: Int
}

type Incident {
    incidentId: ID!
    mmsi: ID!
    openedAtSimMs: Float!
    closedAtSimMs: Float
    maxRiskScore: Int!
    status: IncidentStatus!
    timeline: [IncidentTimelineEvent!]!
}

type OsintAlert {
    alertId: ID!
    source: String!
    title: String!
    body: String!
    region: String!
    issuedAt: DateTime!
    relevanceTags: [String!]!
}

type HighRiskZone {
    zoneId: ID!
    name: String!
    ring: [LatLon!]!
}

type ScenarioSummary {
    scenarioId: ID!
    title: String!
    description: String!
}

type WatchState {
    scenarioId: ID!
    title: String!
    description: String!
    status: WatchStatus!
    simMs: Float!
    centerLat: Float!
    centerLon: Float!
    zoom: Float!
    selectedMmsi: ID
    vessels: [Vessel!]!
    anomalies: [Anomaly!]!
    riskEvents: [RiskEvent!]!
    incidents: [Incident!]!
    osintAlerts: [OsintAlert!]!
    highRiskZones: [HighRiskZone!]!
    protectedAssets: [ProtectedAsset!]!
}

type VesselIntelligenceCitation {
    label: String!
    source: String!
}

type VesselIntelligence {
    mmsi: ID!
    vesselName: String!
    status: String!
    summary: String!
    whyFlagged: String!
    citations: [VesselIntelligenceCitation!]!
    playbookSteps: [String!]!
    generatedAt: DateTime!
}

type SessionUpdateWatchSnapshot {
    watch: WatchState!
}

type SessionUpdateAnomalyAppended {
    anomaly: Anomaly!
}

type SessionUpdateIntelligence {
    intelligence: VesselIntelligence!
}

union SessionUpdate = SessionUpdateWatchSnapshot | SessionUpdateAnomalyAppended | SessionUpdateIntelligence

# Anonymous cookie session writes — no login. `sessionOperatorEnsure` may
# bind a silent Operator user for chat authorship FKs.
type SessionMutation {
    vesselSelect(mmsi: ID): WatchState
    vesselIntelligenceRequest(mmsi: ID!): MutationResult!
    alertAcknowledge(incidentId: ID!): WatchState
    scenarioReset: WatchState
    chatMessageCreate(chatId: ID, message: String!, fileUploadIds: [ID!], assistantOptions: ChatAssistantOptions!): ChatMessageCreateResult
    chatInputCollectionRespond(
        collectionMessageId: ID!
        answers: [ChatMessageUserInputAnswerCreate!]!
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
    chatToolApprovalRespond(
        approvalId: String!
        approved: Boolean!
        reason: String
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
}

type UserMutation {
    userUpdate(user: UserUpdate!): MutationResult!
    terminateSessions(sessionIds: [ID!]!): MutationResult!
    chatMessageCreate(chatId: ID, message: String!, fileUploadIds: [ID!], assistantOptions: ChatAssistantOptions!): ChatMessageCreateResult
    chatInputCollectionRespond(
        collectionMessageId: ID!
        answers: [ChatMessageUserInputAnswerCreate!]!
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
    chatToolApprovalRespond(
        approvalId: String!
        approved: Boolean!
        reason: String
        assistantOptions: ChatAssistantOptions!
    ): ChatMessageCreateResult
}

# --- User-input answer write shape -------------------------------------------
#
# GraphQL has no input unions, so we follow the same flat-discriminator pattern
# the `promptUserForInput` Zod tool schema uses: a `kind` enum drives which of
# the optional fields is read. The resolver validates the populated field
# matches `kind` and rejects mismatches before persistence.

enum ChatAssistantInputValueKind {
    Date
    DateRange
    DateTime
    Time
    String
    StringList
    Boolean
}

input ChatMessageUserInputAnswerCreate {
    inputId: ID!
    kind: ChatAssistantInputValueKind!
    date: Date
    dateRangeFrom: Date
    dateRangeTo: Date
    dateTime: DateTime
    time: String
    string: String
    stringList: [String!]
    boolean: Boolean
}

input ChatAssistantOptions {
    generationId: ID
    requireToolCallApprovals: Boolean!
}

type Query {
    currentSession: Session!
}

type Mutation {
    userCreate(user: UserCreate!): MutationResult!
    user: UserMutation!
    # Session-scoped writes (watch scenario + chat). No login required —
    # cookie session is enough; Operator user may be auto-bound for chat FKs.
    session: SessionMutation!
    # Admin-only mutations, gated by `guardAdminMutation`.
    admin: AdminMutation!
}

# Admin read namespace — empty shell until real admin queries land. `ok` keeps
# the GraphQL type non-empty; forks replace it with domain fields.
type Admin {
    ok: Boolean!
}

# Admin write namespace — empty shell until real admin mutations land. Gated by
# `guardAdminMutation`, which stamps the admin `userId` onto the parent for
# downstream resolvers. `ok` keeps the GraphQL type non-empty.
type AdminMutation {
    ok: Boolean!
}

# --- Chat live updates -------------------------------------------------------
#
# A single subscription that delivers every event of an in-flight assistant
# turn — newly persisted `ChatMessage` rows (user message, tool call, approval
# request/response, input collection, final assistant text) and assistant-text
# deltas during streaming. Keyed by an ephemeral, client-allocated
# `generationId` (UUIDv4); the unguessable id IS the capability today. Real
# chat-level authorization will layer on once chats grow user ownership.
#
# `ChatUpdateAssistantTextChunk.chatMessageId` is the current LLM step's
# pre-allocated id; for the final answer step it equals the eventual
# `ChatMessageAssistantText` row that arrives as `ChatUpdateMessageAppended`
# at end-of-stream. Clients use it to swap their in-place streaming row for
# the persisted message with no layout shift. Mid-turn steps that end in
# tools reuse the same id scheme for reasoning chunks (see
# `ChatUpdateAssistantReasoningChunk`).

type ChatUpdateMessageAppended {
    message: ChatMessage!
}

type ChatUpdateAssistantTextChunk {
    chatMessageId: ID!
    delta: String!
}

# Drops the live text buffer for this step id. Used when a publisher needs to
# retract streamed text (e.g. structured-output JSON that leaked through
# `text-delta` before a presentation path took over). Clients must clear the
# matching streaming buffer; the template turn runner does not emit this today.
type ChatUpdateAssistantTextClear {
    chatMessageId: ID!
}

# Gemini thought-summary deltas (`thinkingConfig.includeThoughts` → AI SDK
# `reasoning-delta`). Keyed on the current LLM step's pre-allocated
# `chatMessageId` — the same id the first tool / approval / input-collection /
# assistant-text row of that step will use — so the live "Thinking…" slot
# swaps onto the persisted row with no layout shift. Each step keeps its own
# summary; they are not concatenated across the turn. Flash models disable
# thinking (`thinkingBudget: 0`) and never emit these.
type ChatUpdateAssistantReasoningChunk {
    chatMessageId: ID!
    delta: String!
}

# Live structured body blocks from `partialOutputStream`. Wire payloads fan
# out by `chatMessageId` only; the resolver reloads blocks from the in-process
# live store (pg_notify cannot carry a growing answer).

type ChatUpdateAssistantBlocksClear {
    chatMessageId: ID!
}

type ChatUpdateAssistantBlocksReplace {
    chatMessageId: ID!
    blocks: [ChatAssistantBodyBlock!]!
}

# Marker variant published exactly once per turn — when `chatAssistantTurnRun`
# exits (success or failure). Lets the client tear down per-turn state
# (composer lock, active streamingId) without waiting on the mutation that
# kicked the turn off, since the mutation now returns as soon as the user-side
# row is committed and the agent runs detached.
type ChatUpdateTurnEnded {
    generationId: ID!
}

union ChatUpdate =
    | ChatUpdateMessageAppended
    | ChatUpdateAssistantTextChunk
    | ChatUpdateAssistantTextClear
    | ChatUpdateAssistantReasoningChunk
    | ChatUpdateAssistantBlocksClear
    | ChatUpdateAssistantBlocksReplace
    | ChatUpdateTurnEnded

type Subscription {
    userUpdates: User!
    chatUpdates(generationId: ID!): ChatUpdate!
    # Per cookie-session watch stream — ticks, anomalies, risk/incidents, AI briefs.
    # Channel is the requesting session id (server-bound; clients cannot pick
    # another session's channel).
    sessionUpdates: SessionUpdate!
}
